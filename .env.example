# Application
APP_ENV=development
LOG_LEVEL=INFO
SQLITE_PATH=data/leash.db

# Solana / Anchor
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
OWNER_WALLET_PATH=keys/owner-devnet.json
AGENT_WALLET_PATH=keys/agent-devnet.json
TREASURY_WALLET_PATH=keys/treasury-devnet.json
LEASH_PROGRAM_ID=EZQjF3NwVTMUrRdDiCwzuabFEoe2viVfFhEaWPkj6gkV
ENABLE_DEVNET_LEASH=false

# Leash limits (used by devnet:init and the local simulator)
PER_TX_CAP_SOL=0.05
DAILY_CAP_SOL=0.2
ALLOWLIST_ENFORCED=true
INIT_DEPOSIT_SOL=0.5
# How much real SOL budget one paper-USDC of BUY consumes
SOL_PER_USDC_BUDGET=0.001
# Optional explicit recipient; defaults to the treasury wallet's pubkey
SPEND_RECIPIENT=

# Research + scoring (demo agent)
GROQ_API_KEY=
TRACKED_ASSETS=SOL,RNDR,IO,PYTH
POLL_INTERVAL_SECONDS=900
SENTIMENT_THRESHOLD=0.6
CONFIDENCE_THRESHOLD=0.7

# Paper trading (demo agent)
STARTING_PAPER_CASH_USDC=1000.0
BASE_TRADE_AMOUNT_USDC=5.0
PER_TRADE_BUY_LIMIT_USDC=5.0
MAX_POSITION_PCT=0.20
MAX_DRAWDOWN_PCT=0.30
STOP_LOSS_PCT=0.15

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=100
