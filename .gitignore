# Environment
.env
venv/
.venv/
# The Quantinuum stack lives in its own 1.4 GB venv; `git add -A` must not eat it.
.venv-quantinuum/
__pycache__/
*.pyc

# Keys and secrets - NEVER commit these
keys/
secrets/
*.enc
*.pem

# Database
*.db
*.db-journal
/data/
.tmp-pip/
.tmp-tests/
.tmp-installs/
.tools/
.publish-clone/
.publish-push/
.publish-sync/
.publish-docs/
pytest-cache-files-*/

# Anchor / Solana build artifacts
target/
.anchor/
test-ledger/
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# Dashboard build
dashboard/dist/
dashboard/node_modules/

# Anchor version manager
.avm-home/

# Log files
*.log

# Workbench reports (committed examples excepted).
# `reports/*` rather than `reports/` so the negation below can re-include
# reports/examples/ — git never descends into a fully-ignored directory.
reports/*
!reports/examples/

# local agent prompts and settings
.claude/
